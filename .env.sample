# Copy this file to .env and fill in your key.
# .env is gitignored, and the key is only ever read by the Express backend,
# so it is never bundled into the browser code.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Port the backend listens on. If you change this, update the proxy target
# in vite.config.js to match.
PORT=5174

# Optional: override the models used.
GROQ_CODEGEN_MODEL=llama-3.3-70b-versatile
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile
