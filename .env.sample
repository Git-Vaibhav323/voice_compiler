# ─── Copy this file to .env for local development ─────────────────────────────
# .env is gitignored. Never commit real keys.
#
# PRODUCTION env vars are set in the platform dashboards:
#   • Render  → voice-compiler-api  → Environment
#   • Netlify → your site           → Site → Environment variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend (Render / local) ──────────────────────────────────────────────────

# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Port the backend listens on locally.
# Must match the proxy target in vite.config.js.
PORT=5174

# Optional: restrict which frontend origin the backend accepts in production.
# Set this to your Netlify URL once it is deployed, e.g.:
#   ALLOWED_ORIGIN=https://your-app.netlify.app
# Leave blank in .env so local dev stays unrestricted.
ALLOWED_ORIGIN=

# Optional: override the Groq models used.
GROQ_CODEGEN_MODEL=llama-3.3-70b-versatile
GROQ_ANALYSIS_MODEL=llama-3.3-70b-versatile

# ── Frontend (Netlify / local) ────────────────────────────────────────────────

# In local dev this is unused — Vite proxies /api to localhost:5174 instead.
# In production (Netlify), set this to your Render backend URL, e.g.:
#   VITE_API_BASE_URL=https://voice-compiler-api.onrender.com/api
VITE_API_BASE_URL=
